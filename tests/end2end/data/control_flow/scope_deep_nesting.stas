// EXPECT: 1
// EXPECT: 2
// EXPECT: 1

int a = 1;
print(a);

if (true) {
    // В новой области видимости объявляем переменную
    int b = 2;
    print(b);

    // При выходе отсюда 'b' должна удалиться со стека (OP_POP)
}

// Если 'b' не удалилась корректно, этот принт может напечатать мусор или упасть
print(a);
