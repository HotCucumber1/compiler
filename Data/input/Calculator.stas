enum MyOperator : string
{
    case Plus = "+"
    case Minus = "-"
    case Multiply = "*"
    case Divide = "/"
}

schema Calculator
{
    // коммент
    state Ready() {
        func digit(int d) -> FirstNumber
        func clear() -> Ready
    }

    state FirstNumber(int current) {
        func digit(int d) -> FirstNumber
        func operator(MyOperator op) -> SecondNumber
        func clear() -> Ready
        func equal() -> Ready
    }

    state SecondNumber(int first, MyOperator op) {
        func digit(int d) -> SecondNumberWithValue
        func clear() -> Ready
    }

    state SecondNumberWithValue(int first, MyOperator op, int current) {
        func digit(int d) -> SecondNumberWithValue
        func equal() -> Compute
        func clear() -> Ready
    }

    state Compute(int first, MyOperator op, int second) {
        func execute() -> Result
    }

    state Result(int value) {
        func digit(int d) -> FirstNumber
        func clear() -> Ready
        func operator(MyOperator op) -> SecondNumber
    }
}




impl Calculator<Ready>
{
    public func digit(int d) -> Calculator<FirstNumber> {
        return new Calculator<FirstNumber>(d);
    }

    public func clear() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }
}

impl Calculator<FirstNumber>
{
    public func digit(int d) -> Calculator<FirstNumber> {
        return new Calculator<FirstNumber>(this.current * 10 + d);
    }

    public func operator(MyOperator op) -> Calculator<SecondNumber> {
        return new Calculator<SecondNumber>(this.current, op);
    }

    public func clear() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }

    public func equal() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }
}

impl Calculator<SecondNumber>
{
    public func digit(int d) -> Calculator<SecondNumberWithValue> {
        return new Calculator<SecondNumberWithValue>(this.first, this.op, d);
    }

    public func clear() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }
}

impl Calculator<SecondNumberWithValue>
{
    public func digit(int d) -> Calculator<SecondNumberWithValue> {
        return new Calculator<SecondNumberWithValue>(this.first, this.op, this.current * 10 + d);
    }

    public func equal() -> Calculator<Compute> {
        return new Calculator<Compute>(this.first, this.op, this.current);
    }

    public func clear() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }
}

impl Calculator<Compute>
{
    public func execute() -> Calculator<Result> {
        int result = match this.op {
            MyOperator.Plus => this.first + this.second,
            MyOperator.Minus => this.first - this.second,
            MyOperator.Multiply => this.first * this.second,
            MyOperator.Divide => 5,
        };
        return new Calculator<Result>(result);
    }
}

impl Calculator<Result>
{
    public func digit(int d) -> Calculator<FirstNumber> {
        return new Calculator<FirstNumber>(d);
    }

    public func clear() -> Calculator<Ready> {
        return new Calculator<Ready>();
    }

    public func operator(MyOperator op) -> Calculator<SecondNumber> {
        return new Calculator<SecondNumber>(this.value, op);
    }
}


Calculator calc = new Calculator<Ready>()
    .digit(5)
    .digit(3)
    .operator(MyOperator.Plus)
    .digit(2)
    .digit(7)
    .equal()
    .execute();

print(calc.value);
