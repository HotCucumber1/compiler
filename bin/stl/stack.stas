schema Stack {
    state Empty(int lastPopped) {
        func push(int val) -> OneItem
    }

    state OneItem(int lastPopped, int v1) {
        func push(int val) -> Full
        func pop() -> Empty
    }

    state Full(int lastPopped, int v1, int v2) {
        func pop() -> OneItem
    }
}


impl Stack<Empty> {
    public func push(int val) -> Stack<OneItem> {
        return new Stack<OneItem>(this.lastPopped, val);
    }
}

impl Stack<OneItem> {
    public func push(int val) -> Stack<Full> {
        return new Stack<Full>(this.lastPopped, this.v1, val);
    }

    public func pop() -> Stack<Empty> {
        return new Stack<Empty>(this.v1);
    }
}

impl Stack<Full> {
    public func pop() -> Stack<OneItem> {
        return new Stack<OneItem>(this.v2, this.v1);
    }
}
