func Abs(int a): int {
    if (a < 0) {
        return 0 - a;
    }
    return a;
}


func AbsFloat(float a): float {
    if (a < 0.0) {
        return 0.0 - a;
    }
    return a;
}


func Max(int a, int b): int {
    if (a > b) {
        return a;
    }
    return b;
}


func Min(int a, int b): int {
    if (a < b) {
        return a;
    }
    return b;
}

func Clamp(int val, int minVal, int maxVal): int {
    if (val < minVal) {
        return minVal;
    }
    if (val > maxVal) {
        return maxVal;
    }
    return val;
}

func Pow(int base, int exp): int {
    if (exp == 0) {
        return 1;
    }

    int result = 1;
    for (int i = 0; i < exp; i = i + 1) {
        result = result * base;
    }

    return result;
}

func Factorial(int n): int {
    if (n < 2) {
        return 1;
    }

    int result = 1;
    for (int i = 2; i < n + 1; i = i + 1) {
        result = result * i;
    }

    return result;
}

func IsEven(int n): bool {
    return n - (n / 2) * 2 == 0;
}

func Sign(int a): int {
    if (a > 0) {
        return 1;
    }
    if (a < 0) {
        return 0 - 1;
    }
    return 0;
}