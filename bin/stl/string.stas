schema StringBuilder
{
    state Ready(string text) {
        func append(string str) -> Ready
        func clear() -> Ready
    }
}

impl StringBuilder<Ready>
{
    public func append(string str) -> StringBuilder<Ready> {
        return new StringBuilder<Ready>(this.text + str);
    }

    public func clear() -> StringBuilder<Ready> {
        return new StringBuilder<Ready>("");
    }
}
