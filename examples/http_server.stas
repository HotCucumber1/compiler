import "../bin/stl/http_server.stas"

let HttpServer serverInit = new HttpServer<Offline>();
let HttpServer server = serverInit.start(8080);

print("Stasis Web Server is running on http://localhost:8080");

while (true) {
    let HttpServer activeServer = server.accept();

    let ServerRequest reqInit = new ServerRequest<Init>();
    let ServerRequest req = reqInit.parse(activeServer.reqHandle);

    print("--> Incoming request:");
    print(req.method);
    print(req.path);

    let string responseBody = "";
    let int status = 200;

    if (req.path == "/") {
        responseBody = "{\"status\": \"ok\", \"message\": \"Welcome to Stasis Server!\"}";
    } else {
        status = 404;
        responseBody = "{\"error\": \"Not Found\"}";
    }

    let ServerRequest doneReq = req.respond(status, responseBody, "application/json");
    server = activeServer.resume();
}
