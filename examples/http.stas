import "../bin/stl/modules/http.stasm"


let HttpRequest req1 = new HttpRequest<Idle>()
    .init()
    .url("http://httpbin.org/post")
    .header("Content-Type: application/json")
    .body("{ \"title\": \"TSOP is awesome\" }")
    .method("POST");

let HttpRequest req2 = new HttpRequest<Idle>()
    .init()
    .url("http://httpbin.org/post")
    .header("Content-Type: application/json")
    .body("{ \"title\": \"TSOP is awesome\" }")
    .method("POST");

req1 = req1.sendAsync();
req2 = req2.sendAsync();

print("Запросы выполняются в фоне...");

req1 = req1.await();
req2 = req2.await();

print("Request 1. Status:");
print(req1.status);

print("Request 2. Status:");
print(req2.status);
