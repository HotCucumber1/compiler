import "../bin/stl/thread.stas"

func someMath(int base, int multiplier): int {
    int sum = 0;
    for (int i = 0; i < 1000; i = i + 1) {
        sum = sum + (base + multiplier);
    }
    return sum;
}

int baseData = 42;
Thread j1 = new Thread<Idle>();
Thread t2 = new Thread<Idle>();

t1 = t1.spawn(someMath, [move baseData, 10]);
t2 = t2.spawn(someMath, [100, 20]);

print("Threads are working...");

t1 = t1.join();
t2 = t2.join();

print("Result 1:");
print(t1.result);

print("Result 2:");
print(t2.result);
