import "../bin/stl/thread.stas"

func burnCPU(int id, int iterations) : int {
    int sum = 0;
    for (int i = 0; i < iterations; i = i + 1) {
        sum = sum + (i * 2) / 2;
    }
    return sum;
}

int ITERS = 1000000;

print("=== Sequential Test ===");
int startSeq = time();

int s1 = burnCPU(1, ITERS);
int s2 = burnCPU(2, ITERS);

int endSeq = time();
print("Sequential time:");
print(endSeq - startSeq);


print("=== Parallel Test ===");
int startPar = time();

Thread t1 = new Thread<Idle>();
Thread t2 = new Thread<Idle>();

t1 = t1.spawn(burnCPU, [1, ITERS]);
t2 = t2.spawn(burnCPU, [2, ITERS]);

t1 = t1.join();
t2 = t2.join();

int endPar = time();
print("Parallel time:");
print(endPar - startPar);

print("Sanity check (must be equal):");
print(s1 + s2);
print(t1.result + t2.result);
