import "../bin/stl/modules/thread.stasm"

func burnCPU(int id, int iterations): float {
    let float sum = 0;
    for (int i = 0; i < iterations; i = i + 1) {
        sum = sum + (i * 2) / 2;
    }
    return sum;
}



const int ITERS = 1000000;

print("=== Sequential Test ===");
const int startSeq = time();

const float s1 = burnCPU(1, ITERS);
const float s2 = burnCPU(2, ITERS);

const int endSeq = time();
print("Sequential time:");
const int seqRes = endSeq - startSeq;
print(seqRes);




print("=== Parallel Test ===");
const int startPar = time();

let Thread t1 = new Thread<Idle>();
let Thread t2 = new Thread<Idle>();

t1 = t1.spawn(burnCPU, [1, ITERS]);
t2 = t2.spawn(burnCPU, [2, ITERS]);

t1 = t1.join();
t2 = t2.join();

const int endPar = time();
print("Parallel time:");
const int parRes = endPar - startPar;
print(parRes);

print("Sanity check (must be equal):");
print(s1 + s2);
print(t1.result + t2.result);

print("Speed up: ");
print(seqRes / parRes);
