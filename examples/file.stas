import "../bin/stl/file.stas"


let int start = time();

let File file = new File<Closed>("../test.txt");

file = file
    .open()
    .read();

print(file.content);
print("Length: ");
print(len(file.content));

file = file
    .write("New text from my example 123!")
    .save()
    .close();

let int endTime = time();

print("");
print("Total time (ns): ");
print(endTime - start);
